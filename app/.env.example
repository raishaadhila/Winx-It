# Backend API
# Local dev default: http://localhost:8000
# Production: your deployed FastAPI URL (Railway, Render, Fly.io, etc.)
VITE_API_URL=http://localhost:8000

# Supabase configuration
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy the values below into a new file named `.env`
#
# Then enable auth providers in Supabase Dashboard:
#   Authentication → Providers → Google  (paste OAuth client id/secret)
#   Authentication → Providers → GitHub (paste OAuth client id/secret)
#
# Add this URL to Supabase allowed redirect URLs:
#   http://localhost:5173/dashboard

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
