# Backend API
# Local dev:  http://localhost:8000
# Vercel:     /api  (same origin — the vercel.json rewrites route /api/*
#             to the FastAPI serverless function)
VITE_API_URL=/api

# Supabase configuration
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy the values below into a new file named `.env`
#
# Then enable auth providers in Supabase Dashboard:
#   Authentication → Providers → Google  (paste OAuth client id/secret)
#   Authentication → Providers → GitHub (paste OAuth client id/secret)
#
# Add this URL to Supabase allowed redirect URLs (Production):
#   https://<your-vercel-app>.vercel.app/dashboard

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
