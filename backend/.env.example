# Supabase — get from Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY   # server-only, bypasses RLS
SUPABASE_JWT_SECRET=YOUR-JWT-SECRET          # Project Settings → API → JWT Secret

# DeepSeek via NVIDIA NIM (the only LLM provider — no OpenAI, no direct DeepSeek)
# 1. Get your key at https://build.nvidia.com → any DeepSeek model → "Get API Key"
# 2. The base URL is the NIM OpenAI-compatible API endpoint (NOT the model page)
NVIDIA_API_KEY=nvapi-YOUR-NVIDIA-KEY
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
ENVIRONMENT=development
